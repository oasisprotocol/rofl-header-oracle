# ROFL Header Oracle - Multi-Chain Configuration
# ===============================================
# Each chain runs as a separate container (oracle-base, oracle-eth, oracle-arb).
# To enable/disable a chain, comment/uncomment its service in compose.yaml.
# If a chain's service is enabled, its RPC URL is REQUIRED.

# ===========================================
# SHARED CONFIGURATION (all chains)
# ===========================================
TARGET_RPC_URL=https://testnet.sapphire.oasis.io
ROFL_ADAPTER_ADDRESS=YOUR_ROFL_ADAPTER_ADDRESS

# Oracle mode: event_listener, push, watcher, or token_watcher
ORACLE_MODE=event_listener

# HTTP settings
REQUEST_TIMEOUT=30
RETRY_COUNT=3

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# ===========================================
# BASE CHAIN (Chain ID: 8453) → oracle-base
# ===========================================
BASE_SOURCE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# Event listener mode only
# BASE_SOURCE_CONTRACT_ADDRESS=0x...  # BlockHeaderRequester on Base
# BASE_POLLING_INTERVAL=2
# BASE_LOOKBACK_BLOCKS=100

# Watcher mode only
# BASE_WATCH_ADDRESSES=0xAddress1,0xAddress2
# BASE_SCAN_INTERVAL=2
# BASE_WATCHER_BATCH_SIZE=50
# BASE_ENABLE_INTERNAL_TX_DETECTION=false

# Push mode only
# BASE_PUSH_INTERVAL=2
# BASE_PUSH_BATCH_SIZE=20

# Token watcher mode only (also uses SCAN_INTERVAL from watcher)
# BASE_TOKEN_ADDRESSES=0xTokenAddress
# BASE_RECIPIENT_ADDRESSES=0xRecipient1,0xRecipient2
# BASE_MAX_BLOCKS_PER_SCAN=10

# ===========================================
# ETHEREUM (Chain ID: 1) → oracle-eth
# ===========================================
ETH_SOURCE_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Event listener mode only
# ETH_SOURCE_CONTRACT_ADDRESS=0x...  # BlockHeaderRequester on Ethereum
# ETH_POLLING_INTERVAL=12
# ETH_LOOKBACK_BLOCKS=100

# Watcher mode only
# ETH_WATCH_ADDRESSES=0xAddress1,0xAddress2
# ETH_SCAN_INTERVAL=12
# ETH_WATCHER_BATCH_SIZE=50
# ETH_ENABLE_INTERNAL_TX_DETECTION=false

# Push mode only
# ETH_PUSH_INTERVAL=12
# ETH_PUSH_BATCH_SIZE=20

# Token watcher mode only (also uses SCAN_INTERVAL from watcher)
# ETH_TOKEN_ADDRESSES=0xTokenAddress
# ETH_RECIPIENT_ADDRESSES=0xRecipient1,0xRecipient2
# ETH_MAX_BLOCKS_PER_SCAN=10

# ===========================================
# ARBITRUM (Chain ID: 42161) → oracle-arb
# ===========================================
ARB_SOURCE_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Event listener mode only
# ARB_SOURCE_CONTRACT_ADDRESS=0x...  # BlockHeaderRequester on Arbitrum
# ARB_POLLING_INTERVAL=1
# ARB_LOOKBACK_BLOCKS=100

# Watcher mode only
# ARB_WATCH_ADDRESSES=0xAddress1,0xAddress2
# ARB_SCAN_INTERVAL=1
# ARB_WATCHER_BATCH_SIZE=50
# ARB_ENABLE_INTERNAL_TX_DETECTION=false

# Push mode only
# ARB_PUSH_INTERVAL=1
# ARB_PUSH_BATCH_SIZE=20

# Token watcher mode only (also uses SCAN_INTERVAL from watcher)
# ARB_TOKEN_ADDRESSES=0xTokenAddress
# ARB_RECIPIENT_ADDRESSES=0xRecipient1,0xRecipient2
# ARB_MAX_BLOCKS_PER_SCAN=10

# ===========================================
# LOCAL MODE (testing without ROFL)
# ===========================================
LOCAL_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
