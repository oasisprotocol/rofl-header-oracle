# Common configuration (all modes)
SOURCE_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
TARGET_RPC_URL=https://testnet.sapphire.oasis.io
ROFL_ADAPTER_ADDRESS=YOUR_ROFL_ADAPTER_ADDRESS  # ROFLAdapter contract address on Sapphire
REQUEST_TIMEOUT=30  # HTTP request timeout in seconds
RETRY_COUNT=3  # Number of retry attempts

# Oracle mode: event_listener, push, or watcher
ORACLE_MODE=event_listener

# Event Listener Mode Configuration (ORACLE_MODE=event_listener)
SOURCE_CONTRACT_ADDRESS=0x85BfE05492aFC3D04Ff3B2ca6771ACF6f853d90d  # BlockHeaderRequester contract
POLLING_INTERVAL=12  # Seconds between event checks
LOOKBACK_BLOCKS=100  # Blocks to look back on startup

# Push Mode Configuration (ORACLE_MODE=push)
PUSH_INTERVAL=60  # Seconds between block pushes
PUSH_BATCH_SIZE=20  # Max blocks to push per iteration

# Watcher Mode Configuration (ORACLE_MODE=watcher)
WATCH_ADDRESSES=0xAddress1,0xAddress2  # Comma-separated addresses to watch
SCAN_INTERVAL=60  # Seconds between scanning for interactions
WATCHER_BATCH_SIZE=50  # Max blocks to scan per iteration
# LOOKBACK_BLOCKS=100  # Also used in watcher mode
ENABLE_INTERNAL_TX_DETECTION=false  # Enable internal transaction detection (requires archive node with debug API)

# Local mode configuration (for testing without ROFL)
# Only required when running with --local flag or compose.local.yaml
LOCAL_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef